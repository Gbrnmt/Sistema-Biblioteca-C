{
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar Biblioteca",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-Wall", "-Wextra", "-Iinclude",
                "src/main.c", "src/utils.c", "src/datas.c", "src/livro.c",
                "src/ordenacao.c", "src/busca.c", "src/desempenho.c",
                "src/usuario.c", "src/emprestimo.c", "src/arquivo.c",
                "-o", "biblioteca.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "version": "2.0.0"
}